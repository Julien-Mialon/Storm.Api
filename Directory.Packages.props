<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <ServiceStackVersion>10.5.0</ServiceStackVersion>
    <AspNetVersion>10.0.15</AspNetVersion>
    <SentryVersion>7.1.0</SentryVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- utils -->
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <PackageVersion Include="Resend" Version="0.28.0" />
    <PackageVersion Include="VaultSharp" Version="1.17.5.1" />
    <PackageVersion Include="System.Text.Json" Version="$(AspNetVersion)" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- aspnet -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(AspNetVersion)" />
    <!-- swagger -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="$(AspNetVersion)" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.21.0" />
    <!-- logs -->
    <PackageVersion Include="Elastic.Clients.Elasticsearch" Version="8.19.27" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- service stack -->
    <PackageVersion Include="ServiceStack.OrmLite" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.OrmLite.SqlServer.Data" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.OrmLite.Sqlite" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.OrmLite.MySql" Version="$(ServiceStackVersion)" />
    <PackageVersion Include="ServiceStack.OrmLite.PostgreSQL" Version="$(ServiceStackVersion)" />
    <!-- redis -->
    <PackageVersion Include="StackExchange.Redis" Version="2.13.23" />
    <!-- jwt -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <!-- sentry -->
    <PackageVersion Include="Sentry" Version="$(SentryVersion)" />
    <PackageVersion Include="Sentry.AspNetCore" Version="$(SentryVersion)" />
    <!-- nuget source link -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.404" />
    <!-- Source generators -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />
    <!-- testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
		<!-- CVE -->
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(AspNetVersion)" />
  </ItemGroup>
</Project>